<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.hooksmith.vulnlab">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="HookSmith VulnLab" android:usesCleartextTraffic="true" android:debuggable="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vulnlab" android:host="open" />
            </intent-filter>
        </activity>
    </application>
</manifest>
